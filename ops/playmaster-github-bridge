#!/usr/bin/env bash
set -euo pipefail

# This command is intended to be used as an SSH forced command.
# It accepts only fixed, read-only checks and never evaluates arbitrary input.

case "${SSH_ORIGINAL_COMMAND:-}" in
  action:test-status)
    sudo -n /usr/bin/docker ps --filter name=playmaster-auto-import-test --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
    ;;
  action:nginx-config-test)
    sudo -n /usr/sbin/nginx -t
    ;;
  action:test-http-check)
    curl --connect-timeout 5 --max-time 10 -sS -o /dev/null -w 'HTTP %{http_code}\n' http://127.0.0.1:3602/
    ;;
  *)
    echo "Operation not allowed" >&2
    exit 64
    ;;
esac
